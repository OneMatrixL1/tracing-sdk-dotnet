{
  // Your Indexer and the API key of your client.
  "endpoint": "http://localhost:8080",
  "auth": { "type": "apiToken", "token": "your-api-token" },

  // Tickets and records are JSON, canonicalized (RFC 8785) before hashing.
  // A batch answers only once it is confirmed on chain: allow a long timeout.
  "options": { "dataType": "json", "timeoutMs": 60000 },

  // Where verification links point. Optional: this is the default.
  "portal": {
    "baseUrl": "https://integrity.vmatrix.com/v1/"
  }
}
